{
  "uid": "quicc-printer-health",
  "title": "Quicc — Printer health",
  "tags": ["quicc", "printer"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "links": [
    {
      "type": "dashboards",
      "title": "Quicc dashboards",
      "tags": ["quicc"],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(deployment_environment)",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Printer status (last known)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["last"] },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ],
          "noValue": "no printers",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "green", "value": 1 }] }
        }
      },
      "links": [
        {
          "title": "Agent logs",
          "url": "/d/quicc-logs-explorer?var-env=${env}&var-service=quicc-agent&${__url_time_range}"
        }
      ],
      "targets": [
        {
          "expr": "printer_status{deployment_environment=\"$env\"}",
          "legendFormat": "{{printer_name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Detect duration p95",
      "description": "TCP dial to the printer on the health-check loop (every PRINTER_DETECT_DELAY, default 25s).",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 5000 }] }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (printer_name, le) (rate(printer_detect_duration_milliseconds_bucket{deployment_environment=\"$env\"}[$__rate_interval])))",
          "legendFormat": "{{printer_name}}",
          "exemplar": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Print write duration p95",
      "description": "Time writing ESC/POS bytes to the printer over TCP :9100.",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 2000 }, { "color": "red", "value": 10000 }] }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (printer_name, le) (rate(printer_write_duration_milliseconds_bucket{deployment_environment=\"$env\"}[$__rate_interval])))",
          "legendFormat": "{{printer_name}}",
          "exemplar": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Print throughput",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".* · ok" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byRegexp", "options": ".* · (error|detect_failed)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "targets": [
        {
          "expr": "sum by (printer_name, result) (rate(orders_printed_total{deployment_environment=\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{printer_name}} · {{result}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "SSE reconnects (24h)",
      "gridPos": { "x": 12, "y": 14, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 30 }] }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(sse_reconnects_total{deployment_environment=\"$env\"}[24h]))",
          "legendFormat": "reconnects"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "SSE reconnects per hour",
      "gridPos": { "x": 18, "y": 14, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "drawStyle": "bars", "fillOpacity": 80 } } },
      "targets": [
        {
          "expr": "sum(increase(sse_reconnects_total{deployment_environment=\"$env\"}[1h]))",
          "legendFormat": "reconnects"
        }
      ]
    },
    {
      "id": 100,
      "type": "row",
      "title": "Agent HTTP (mobile-facing API)",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request duration p95",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"quicc-agent\", deployment_environment=\"$env\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "exemplar": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requests by status code",
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "5.." }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byRegexp", "options": "4.." }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      },
      "targets": [
        {
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=\"quicc-agent\", deployment_environment=\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    }
  ]
}
