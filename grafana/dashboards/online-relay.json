{
  "uid": "quicc-online-relay",
  "title": "Quicc — Online relay health",
  "tags": ["quicc", "online"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "links": [
    {
      "type": "dashboards",
      "title": "Quicc dashboards",
      "tags": ["quicc"],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(deployment_environment)",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Ingest",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Received (range)",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text" }] }
        }
      },
      "targets": [
        { "expr": "sum(increase(orders_received_total{deployment_environment=\"$env\"}[$__range]))", "legendFormat": "received" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Relayed (range)",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }
        }
      },
      "targets": [
        { "expr": "sum(increase(orders_relayed_total{deployment_environment=\"$env\"}[$__range]))", "legendFormat": "relayed" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rejected (range)",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "red", "value": 1 }] }
        }
      },
      "targets": [
        { "expr": "sum(increase(orders_rejected_total{deployment_environment=\"$env\"}[$__range]))", "legendFormat": "rejected" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Order flow",
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "rejected.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "relayed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "targets": [
        { "expr": "sum(rate(orders_received_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "received" },
        { "expr": "sum(rate(orders_relayed_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "relayed" },
        { "expr": "sum by (reason) (rate(orders_rejected_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "rejected · {{reason}}" }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Latency & size",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Relay latency (request receive → SQS ack)",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 2000 }] }
        }
      },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(orders_relay_latency_milliseconds_bucket{deployment_environment=\"$env\"}[$__rate_interval])))", "legendFormat": "p50", "exemplar": true },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(orders_relay_latency_milliseconds_bucket{deployment_environment=\"$env\"}[$__rate_interval])))", "legendFormat": "p95", "exemplar": true }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Order body size",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(orders_body_bytes_bucket{deployment_environment=\"$env\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "expr": "sum(rate(orders_body_bytes_sum{deployment_environment=\"$env\"}[$__rate_interval])) / sum(rate(orders_body_bytes_count{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "avg" }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Auth",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Vendor bearer auth",
      "gridPos": { "x": 0, "y": 19, "w": 9, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "denied.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "allowed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "targets": [
        { "expr": "sum(rate(auth_bearer_allowed_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "allowed" },
        { "expr": "sum by (reason) (rate(auth_bearer_denied_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "denied · {{reason}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Admin passcode auth",
      "gridPos": { "x": 9, "y": 19, "w": 9, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "denied.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "allowed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "targets": [
        { "expr": "sum(rate(auth_admin_allowed_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "allowed" },
        { "expr": "sum by (reason) (rate(auth_admin_denied_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "denied · {{reason}}" }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Auth denies (24h)",
      "description": "Sustained denies smell like a brute-force attempt or a vendor with a stale key.",
      "gridPos": { "x": 18, "y": 19, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 20 }] }
        }
      },
      "targets": [
        { "expr": "sum(increase(auth_bearer_denied_total{deployment_environment=\"$env\"}[24h])) + sum(increase(auth_admin_denied_total{deployment_environment=\"$env\"}[24h]))", "legendFormat": "denies" }
      ]
    },
    {
      "id": 103,
      "type": "row",
      "title": "Keys & liveness",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "API-key lifecycle events",
      "gridPos": { "x": 0, "y": 28, "w": 18, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "drawStyle": "bars", "fillOpacity": 80 } } },
      "targets": [
        { "expr": "sum(increase(keys_generated_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "generated" },
        { "expr": "sum by (path) (increase(keys_activated_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "activated · {{path}}" },
        { "expr": "sum by (result) (increase(keys_bootstrap_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "bootstrap · {{result}}" }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Watchdog stale ticks (24h)",
      "description": "liveness.stale fires when a registered goroutine goes silent past the 120s threshold. Anything non-zero deserves a look.",
      "gridPos": { "x": 18, "y": 28, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["last"] }, "textMode": "value_and_name" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "red", "value": 1 }] }
        }
      },
      "targets": [
        { "expr": "sum by (goroutine) (increase(liveness_stale_total{deployment_environment=\"$env\"}[24h]))", "legendFormat": "{{goroutine}}" }
      ]
    },
    {
      "id": 104,
      "type": "row",
      "title": "HTTP RED (span-metrics)",
      "gridPos": { "x": 0, "y": 35, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Request rate by route",
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"quicc-online\", span_kind=\"SPAN_KIND_SERVER\", deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "{{span_name}}" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "p95 latency by route",
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (span_name, le) (rate(traces_spanmetrics_latency_bucket{service=\"quicc-online\", span_kind=\"SPAN_KIND_SERVER\", deployment_environment=\"$env\"}[$__rate_interval])))", "legendFormat": "{{span_name}}", "exemplar": true }
      ]
    }
  ]
}
