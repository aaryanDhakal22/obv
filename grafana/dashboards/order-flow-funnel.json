{
  "uid": "quicc-order-flow-funnel",
  "title": "Quicc — Order flow funnel (end-to-end)",
  "tags": ["quicc", "orders", "pipeline"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "links": [
    { "type": "dashboards", "title": "Quicc dashboards", "tags": ["quicc"], "asDropdown": true, "keepTime": true, "includeVars": true, "icon": "external link" }
  ],
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(deployment_environment)",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 100, "type": "row", "title": "Funnel — orders through each stage (selected range)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false, "panels": []
    },
    {
      "id": 1, "type": "stat", "title": "1 · online received",
      "description": "POSTs online/ accepted from the vendor.",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "noValue": "0", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "targets": [ { "expr": "sum(increase(orders_received_total{service_name=\"quicc-online\", deployment_environment=\"$env\"}[$__range]))", "legendFormat": "received" } ]
    },
    {
      "id": 2, "type": "stat", "title": "2 · online → SQS relayed",
      "description": "Orders online/ published to SQS. Should track stage 1.",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "noValue": "0", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "targets": [ { "expr": "sum(increase(orders_relayed_total{deployment_environment=\"$env\"}[$__range]))", "legendFormat": "relayed" } ]
    },
    {
      "id": 3, "type": "stat", "title": "3 · main consumed",
      "description": "SQS messages main/ cast into orders.",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "noValue": "0", "color": { "mode": "fixed", "fixedColor": "purple" } } },
      "targets": [ { "expr": "sum(increase(orders_consumed_total{deployment_environment=\"$env\"}[$__range]))", "legendFormat": "consumed" } ]
    },
    {
      "id": 4, "type": "stat", "title": "4 · main persisted",
      "description": "Orders written to Postgres (result=ok).",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "noValue": "0", "color": { "mode": "fixed", "fixedColor": "purple" } } },
      "targets": [ { "expr": "sum(increase(orders_persisted_total{result=\"ok\", deployment_environment=\"$env\"}[$__range]))", "legendFormat": "persisted" } ]
    },
    {
      "id": 5, "type": "stat", "title": "5 · SSE broadcast",
      "description": "Order frames main/ fanned out to a connected agent (result=delivered).",
      "gridPos": { "x": 0, "y": 7, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "noValue": "0", "color": { "mode": "fixed", "fixedColor": "orange" } } },
      "targets": [ { "expr": "sum(increase(sse_events_broadcast_total{event_type=\"order\", result=\"delivered\", deployment_environment=\"$env\"}[$__range]))", "legendFormat": "delivered" } ]
    },
    {
      "id": 6, "type": "stat", "title": "6 · agent received",
      "description": "Order frames the agent got over SSE.",
      "gridPos": { "x": 6, "y": 7, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "noValue": "0", "color": { "mode": "fixed", "fixedColor": "green" } } },
      "targets": [ { "expr": "sum(increase(orders_received_total{service_name=\"quicc-agent\", deployment_environment=\"$env\"}[$__range]))", "legendFormat": "received" } ]
    },
    {
      "id": 7, "type": "stat", "title": "7 · agent printed",
      "description": "Tickets the agent successfully printed. This is the end of the line.",
      "gridPos": { "x": 12, "y": 7, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "noValue": "0", "color": { "mode": "fixed", "fixedColor": "green" } } },
      "targets": [ { "expr": "sum(increase(orders_printed_total{deployment_environment=\"$env\"}[$__range]))", "legendFormat": "printed" } ]
    },
    {
      "id": 8, "type": "stat", "title": "⚠ total drops (range)",
      "description": "Sum of every failure counter across the pipeline. Anything > 0 means an order did NOT complete somewhere — the funnel panels + Drops row show where.",
      "gridPos": { "x": 18, "y": 7, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "noValue": "0", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "red", "value": 1 }] } } },
      "targets": [ { "expr": "sum(increase(orders_rejected_total{deployment_environment=\"$env\"}[$__range])) + sum(increase(orders_cast_failed_total{deployment_environment=\"$env\"}[$__range])) + sum(increase(orders_persist_failed_total{deployment_environment=\"$env\"}[$__range])) + sum(increase(outbox_events_failed_total{deployment_environment=\"$env\"}[$__range])) + sum(increase(orders_print_failed_total{deployment_environment=\"$env\"}[$__range]))", "legendFormat": "drops" } ]
    },
    {
      "id": 101, "type": "row", "title": "Throughput",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 }, "collapsed": false, "panels": []
    },
    {
      "id": 9, "type": "timeseries", "title": "Per-stage throughput (rate)",
      "description": "Each stage's rate. Healthy = the lines overlap. A line dropping below the one to its left = orders lost at that hop.",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 5, "drawStyle": "line" } } },
      "targets": [
        { "expr": "sum(rate(orders_received_total{service_name=\"quicc-online\", deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "1 online received" },
        { "expr": "sum(rate(orders_relayed_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "2 online relayed" },
        { "expr": "sum(rate(orders_consumed_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "3 main consumed" },
        { "expr": "sum(rate(orders_persisted_total{result=\"ok\", deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "4 main persisted" },
        { "expr": "sum(rate(sse_events_broadcast_total{event_type=\"order\", result=\"delivered\", deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "5 SSE broadcast" },
        { "expr": "sum(rate(orders_received_total{service_name=\"quicc-agent\", deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "6 agent received" },
        { "expr": "sum(rate(orders_printed_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "7 agent printed" }
      ]
    },
    {
      "id": 102, "type": "row", "title": "Drops — where orders fail (each ties to a Pushover alert)",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 }, "collapsed": false, "panels": []
    },
    {
      "id": 10, "type": "timeseries", "title": "Failure rate by stage",
      "gridPos": { "x": 0, "y": 24, "w": 14, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 20, "drawStyle": "bars", "stacking": { "mode": "normal" } }, "color": { "mode": "palette-classic-by-name" } } },
      "targets": [
        { "expr": "sum(rate(orders_rejected_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "online rejected" },
        { "expr": "sum(rate(orders_cast_failed_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "main cast-failed" },
        { "expr": "sum(rate(orders_persist_failed_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "main persist-failed" },
        { "expr": "sum(rate(outbox_events_failed_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "main dispatch-failed" },
        { "expr": "sum(rate(orders_print_failed_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "agent print-failed" }
      ]
    },
    {
      "id": 11, "type": "stat", "title": "Drops by stage (range)",
      "description": "Non-zero = a Pushover alert is (or was) firing for that module.",
      "gridPos": { "x": 14, "y": 24, "w": 10, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "orientation": "horizontal", "reduceOptions": { "calcs": ["last"] } },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "noValue": "0", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "red", "value": 1 }] } } },
      "targets": [
        { "expr": "sum(increase(orders_rejected_total{deployment_environment=\"$env\"}[$__range]))", "legendFormat": "online rejected" },
        { "expr": "sum(increase(orders_cast_failed_total{deployment_environment=\"$env\"}[$__range]))", "legendFormat": "main cast-failed" },
        { "expr": "sum(increase(orders_persist_failed_total{deployment_environment=\"$env\"}[$__range]))", "legendFormat": "main persist-failed" },
        { "expr": "sum(increase(outbox_events_failed_total{deployment_environment=\"$env\"}[$__range]))", "legendFormat": "main dispatch-failed" },
        { "expr": "sum(increase(orders_print_failed_total{deployment_environment=\"$env\"}[$__range]))", "legendFormat": "agent print-failed" }
      ]
    }
  ]
}
