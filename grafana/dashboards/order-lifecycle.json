{
  "uid": "quicc-order-lifecycle",
  "title": "Quicc — Order lifecycle",
  "tags": ["quicc", "order"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "links": [
    {
      "type": "dashboards",
      "title": "Quicc dashboards",
      "tags": ["quicc"],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(deployment_environment)",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "traces",
      "title": "Recent order traces (TraceQL)",
      "description": "Every sqs.process span in main — the root of an order's journey. Click one to walk online → main → agent → printer.",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 10 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"quicc-main\" && name = \"sqs.process\" && resource.deployment.environment = \"$env\" }",
          "tableType": "traces",
          "limit": 50
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Stage latency p95",
      "description": "Per-stage span durations: SQS consume tx (main), SSE publish (main), SSE receive + order arrival (agent), physical print (agent).",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{deployment_environment=\"$env\", span_name=\"sqs.process\"}[$__rate_interval])))",
          "legendFormat": "main: sqs.process",
          "exemplar": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{deployment_environment=\"$env\", span_name=\"sse.publish\"}[$__rate_interval])))",
          "legendFormat": "main: sse.publish",
          "exemplar": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{deployment_environment=\"$env\", span_name=\"sse.receive\"}[$__rate_interval])))",
          "legendFormat": "agent: sse.receive",
          "exemplar": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{deployment_environment=\"$env\", span_name=\"order.on_arrival\"}[$__rate_interval])))",
          "legendFormat": "agent: order.on_arrival",
          "exemplar": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{deployment_environment=\"$env\", span_name=\"printer.print\"}[$__rate_interval])))",
          "legendFormat": "agent: printer.print",
          "exemplar": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Orders through the pipeline",
      "description": "The funnel from the front door to paper. Gaps between lines are loss or duplicates.",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "main: persisted · duplicate" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      },
      "links": [
        {
          "title": "Open Pipeline & outbox",
          "url": "/d/quicc-pipeline-outbox?var-env=${env}&${__url_time_range}"
        }
      ],
      "targets": [
        { "expr": "sum(rate(orders_relayed_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "online: relayed" },
        { "expr": "sum(rate(orders_consumed_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "main: consumed" },
        { "expr": "sum by (result) (rate(orders_persisted_total{deployment_environment=\"$env\"}[$__rate_interval]))", "legendFormat": "main: persisted · {{result}}" },
        { "expr": "sum(rate(orders_printed_total{deployment_environment=\"$env\", result=\"ok\"}[$__rate_interval]))", "legendFormat": "agent: printed" }
      ]
    }
  ]
}
