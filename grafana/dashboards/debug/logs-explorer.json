{
  "uid": "quicc-logs-explorer",
  "title": "Quicc — Logs explorer",
  "tags": ["quicc", "logs", "quicc-debug"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "links": [
    {
      "type": "dashboards",
      "title": "Quicc dashboards",
      "tags": ["quicc"],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "description": "deployment_environment label (the collector maps it from deployment.environment.name)",
        "query": "prod,staging,dev",
        "current": { "selected": true, "text": "prod", "value": "prod" },
        "options": [{ "selected": true, "text": "prod", "value": "prod" }, { "selected": false, "text": "staging", "value": "staging" }, { "selected": false, "text": "dev", "value": "dev" }],
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({deployment_environment=\"$env\"}, service_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+"
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": ""
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Volume",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by service",
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": { "mode": "normal", "group": "A" }
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (service_name) (count_over_time({deployment_environment=\"$env\", service_name=~\"$service\"} [$__auto]))",
          "legendFormat": "{{service_name}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Log volume by level",
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "fatal" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } }] },
          { "matcher": { "id": "byName", "options": "warn" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "info" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "debug" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "trace" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }] }
        ]
      },
      "targets": [
        {
          "expr": "sum by (detected_level) (count_over_time({deployment_environment=\"$env\", service_name=~\"$service\"} [$__auto]))",
          "legendFormat": "{{detected_level}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Errors",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate by service",
      "gridPos": { "x": 0, "y": 10, "w": 8, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal", "group": "A" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "red", "value": 1 }] }
        }
      },
      "targets": [
        {
          "expr": "sum by (service_name) (count_over_time({deployment_environment=\"$env\", service_name=~\"$service\"} | detected_level=~\"error|fatal|panic\" [$__auto]))",
          "legendFormat": "{{service_name}}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Recent errors (click a line → View trace)",
      "gridPos": { "x": 8, "y": 10, "w": 16, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{deployment_environment=\"$env\", service_name=~\"$service\"} | detected_level=~\"error|fatal|panic\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Browse",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "logs",
      "title": "All logs ($search filters the line)",
      "gridPos": { "x": 0, "y": 21, "w": 24, "h": 14 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{deployment_environment=\"$env\", service_name=~\"$service\"} |~ `$search`",
          "queryType": "range"
        }
      ]
    }
  ]
}
