    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(storefront_request_duration_milliseconds_bucket{deployment_environment=\"$env\"}[$__rate_interval])))",
     "legendFormat": "{{route}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Errors per minute",
   "description": "5xx answers, uncaught exceptions, and failed calls to main (network or 5xx).",
   "datasource": {
