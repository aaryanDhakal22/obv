  {
   "type": "stat",
   "title": "Placed → picked up, median",
   "description": "Placed → picked up: from the order's start (when it reached main; a scheduled order from the moment the Pi rings it) to the Pi's order.ack. The middle order. Normal is a few seconds.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (((max_over_time({__name__=~\"orders_pickup_latency(_seconds)?_bucket\", deployment_environment=\"$env\", channel=\"web\"}[$__range]) unless {__name__=~\"orders_pickup_latency(_seconds)?_bucket\", deployment_environment=\"$env\", channel=\"web\"} offset $__range) or increase({__name__=~\"orders_pickup_latency(_seconds)?_bucket\", deployment_environment=\"$env\", channel=\"web\"}[$__range]))))",
     "legendFormat": "Placed → picked up, median",
     "range": false,
     "instant": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 10
       },
       {
        "color": "red",
        "value": 30
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "decimals": 1,
     "noValue": "no data"
    },
    "overrides": []
   },
