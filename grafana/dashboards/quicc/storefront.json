 "templating": {
  "list": [
   {
    "name": "env",
    "label": "Environment",
    "type": "custom",
    "query": "staging,prod,dev",
    "current": {
     "selected": true,
     "text": "staging",
     "value": "staging"
    },
    "options": [
     {
      "selected": true,
      "text": "staging",
      "value": "staging"
     },
     {
      "selected": false,
      "text": "prod",
      "value": "prod"
     },
     {
      "selected": false,
      "text": "dev",
      "value": "dev"
     }
