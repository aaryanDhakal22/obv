    {
      "type": "timeseries",
      "title": "Where the time goes (p95)",
      "description": "p95 per minute window: the browser's whole round trip, its internet's share, and main + the store. When the round trip climbs, the line that climbs with it is the culprit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(callcenter_client_request_duration_milliseconds_bucket{deployment_environment=\"$env\", route!~\".* events\"}[5m])))",
          "legendFormat": "round trip",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(callcenter_client_network_duration_milliseconds_bucket{deployment_environment=\"$env\"}[5m])))",
          "legendFormat": "their internet",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(callcenter_upstream_duration_milliseconds_bucket{deployment_environment=\"$env\"}[5m])))",
          "legendFormat": "main + store",
          "range": true,
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
